<?xml version="1.0"?>
<!-- Arène 4 m x 4 m avec quelques obstacles. Les robots sont ajoutés par spawn_robot.launch.py. -->
<sdf version="1.9">
  <world name="armada_arena">
    <physics name="default_physics" type="dart">
      <max_step_size>0.002</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
          <material><ambient>0.75 0.75 0.75 1</ambient><diffuse>0.75 0.75 0.75 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- murs de l'arène -->
    <model name="walls">
      <static>true</static>
      <link name="link">
        <collision name="n"><pose>0 2.05 0.1 0 0 0</pose><geometry><box><size>4.2 0.1 0.2</size></box></geometry></collision>
        <visual name="n"><pose>0 2.05 0.1 0 0 0</pose><geometry><box><size>4.2 0.1 0.2</size></box></geometry><material><diffuse>0.9 0.9 0.8 1</diffuse></material></visual>
        <collision name="s"><pose>0 -2.05 0.1 0 0 0</pose><geometry><box><size>4.2 0.1 0.2</size></box></geometry></collision>
        <visual name="s"><pose>0 -2.05 0.1 0 0 0</pose><geometry><box><size>4.2 0.1 0.2</size></box></geometry><material><diffuse>0.9 0.9 0.8 1</diffuse></material></visual>
        <collision name="e"><pose>2.05 0 0.1 0 0 0</pose><geometry><box><size>0.1 4.0 0.2</size></box></geometry></collision>
        <visual name="e"><pose>2.05 0 0.1 0 0 0</pose><geometry><box><size>0.1 4.0 0.2</size></box></geometry><material><diffuse>0.9 0.9 0.8 1</diffuse></material></visual>
        <collision name="w"><pose>-2.05 0 0.1 0 0 0</pose><geometry><box><size>0.1 4.0 0.2</size></box></geometry></collision>
        <visual name="w"><pose>-2.05 0 0.1 0 0 0</pose><geometry><box><size>0.1 4.0 0.2</size></box></geometry><material><diffuse>0.9 0.9 0.8 1</diffuse></material></visual>
      </link>
    </model>

    <!-- obstacles -->
    <model name="box_1">
      <static>true</static>
      <pose>1.0 0.8 0.1 0 0 0.3</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.3 0.3 0.2</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.3 0.3 0.2</size></box></geometry><material><diffuse>0.8 0.3 0.2 1</diffuse></material></visual>
      </link>
    </model>
    <model name="cylinder_1">
      <static>true</static>
      <pose>-0.8 -0.9 0.1 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><cylinder><radius>0.15</radius><length>0.2</length></cylinder></geometry></collision>
        <visual name="v"><geometry><cylinder><radius>0.15</radius><length>0.2</length></cylinder></geometry><material><diffuse>0.2 0.4 0.8 1</diffuse></material></visual>
      </link>
    </model>
  </world>
</sdf>
